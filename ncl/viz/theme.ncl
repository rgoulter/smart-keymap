# Paint. Scene nodes carry roles; the SVG renderer substitutes these.
#
# Keycaps are KLE-style: a darker side/border plus a raised top, leaving a
#  front lip for hold legends.
{
  light = {
    background = "#f4f1ec",
    title = "#222222",
    key_side = "#cccccc",
    key_top = "#fcfcfc",
    unused_side = "#9a958e",
    unused_top = "#b7b2ab",
    ghost_side = "#ddd9d3",
    ghost_top = "#eeeae4",
    ghost_opacity = "0.45",
    key_stroke = "#b0aaa3",
    legend = "#080808",
    hold = "#c44",
    overlay = "#3b6ea5",
    overlay2 = "#2f9e44",
    overlay3 = "#e67700",
    pressed_side = "#9bb8d4",
    pressed_top = "#d4e5f7",
    muted_side = "#d8d4ce",
    muted_top = "#ece8e2",
    muted_opacity = "0.35",
    chord_output = "#d9480f",
    chord_output_fill = "#fff5f0",
    chord_panel = "#fff8f3",
    chord_panel_stroke = "#f1c0a8",
    font = "ui-monospace,Menlo,monospace",
    title_font = "ui-sans-serif,system-ui,sans-serif",
    layers = [
      { side = "#cccccc", top = "#fcfcfc" },
      { side = "#b4c7de", top = "#d9e6f5" },
      { side = "#b5d0b8", top = "#dcefdc" },
      { side = "#e0c89a", top = "#f6e6c8" },
      { side = "#cbb5d8", top = "#eadcf3" },
      { side = "#d8b4b4", top = "#f3dcdc" },
      { side = "#b4d0cc", top = "#d8ece8" },
      { side = "#d0c4b0", top = "#efe6d8" },
    ],
  },

  dark = {
    background = "#1a1a1a",
    title = "#eeeeee",
    key_side = "#3a3a3a",
    key_top = "#4a4a4a",
    unused_side = "#2a2a2a",
    unused_top = "#323232",
    ghost_side = "#2c2c2c",
    ghost_top = "#333333",
    ghost_opacity = "0.4",
    key_stroke = "#666666",
    legend = "#f2f2f2",
    hold = "#ff6b6b",
    overlay = "#74c0fc",
    overlay2 = "#8ce99a",
    overlay3 = "#ffc078",
    pressed_side = "#1a3348",
    pressed_top = "#2a5578",
    muted_side = "#2a2a2a",
    muted_top = "#333333",
    muted_opacity = "0.35",
    chord_output = "#ff922b",
    chord_output_fill = "#2b1810",
    chord_panel = "#2b1810",
    chord_panel_stroke = "#7a3e18",
    font = "ui-monospace,Menlo,monospace",
    title_font = "ui-sans-serif,system-ui,sans-serif",
    layers = [
      { side = "#3a3a3a", top = "#4a4a4a" },
      { side = "#2a4460", top = "#3d648a" },
      { side = "#2a4a32", top = "#3d6b48" },
      { side = "#5a4420", top = "#7a6030" },
      { side = "#4a3060", top = "#684878" },
      { side = "#5a3030", top = "#784848" },
      { side = "#2a4a48", top = "#3d6864" },
      { side = "#4a4030", top = "#685848" },
    ],
  },
}

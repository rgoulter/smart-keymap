#lang rhombus
//// 48key-basic: grid(4,12) + Nickel LegendIR from keymap-48key-basic

import:
  "../../src/keyboard_layout.rhm" open
  "../../src/svg.rhm" open
  "../../src/io.rhm" open

def bundle = "out/.cache/48key-basic-bundle.json"
def pts = grid(4, 12)
def layers = load_bundle_layers(bundle)
def dense = load_bundle_dense(bundle)

ensure_dir("out")
emit_points("out/points-48key-basic.json", pts)
emit_svg(
  "out/48key-basic-dense.svg",
  recipe_dense(
    "48key-basic dense",
    pts,
    dense
  )
)
emit_svg(
  "out/48key-basic-stacked.svg",
  recipe_stacked(
    "48key-basic",
    pts,
    layers
  )
)
emit_svg(
  "out/48key-basic-stacked-dark.svg",
  recipe_stacked(
    "48key-basic",
    pts,
    layers
  ),
  ~theme: theme_dark
)
println("DONE 48key_basic")

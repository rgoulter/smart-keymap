#lang rhombus
//// 36key KiCad LHS+RHS weave + same LegendIR as 36key-rgoulter

import:
  "../../src/keyboard_layout.rhm" open
  "../../src/svg.rhm" open
  "../../src/io.rhm" open

def bundle = "out/.cache/36key-rgoulter-bundle.json"
def layers = load_bundle_layers(bundle)
def names = [
  "Base (Dvorak)",
  "Tap (Dvorak)",
  "Extra (QWERTY)",
  "Xtap (QWERTY)",
  "NUM",
  "SYM",
  "FUN",
  "NAV",
  "MOU",
  "MED"
]
def lhs = load_switches("fixtures/points/ch32x-36-lhs-switches.json")
def rhs = load_switches("fixtures/points/ch32x-36-rhs-switches.json")
def pts = weave_kicad_3x5_3(lhs, rhs)

ensure_dir("out")
emit_points("out/points-36key-kicad.json", pts)
emit_svg(
  "out/36key-kicad-stacked.svg",
  recipe_stacked(
    "36key KiCad LHS+RHS",
    pts,
    layers,
    ~layer_names: names
  )
)
println("DONE 36key_kicad")

board := "ncl/boards/ch32x-48.ncl"

# Board id: ncl/boards/ prefix stripped, .ncl stripped,
#  "/" -> "-".
#  ch32x-60-improved.ncl -> ch32x-60-improved
#  ch32x-48/rev2025_2.ncl -> ch32x-48-rev2025_2
# Outside ncl/boards/ uses file stem.
board_noprefix := replace(board, "ncl/boards/", "")
board_noext := trim_end_match(board_noprefix, ".ncl")
board_id_raw := replace(board_noext, "/", "-")
board_id := if board_noprefix != board {
  trim_start_match(board_id_raw, "-")
} else {
  file_stem(board)
}

# Keymap id from SMART_KEYMAP_CUSTOM_KEYMAP.
#  keymap.ncl/json -> parent dir name
#   (keymap-66key-extend/keymap.ncl -> keymap-66key-extend)
#  else file stem (my-custom.ncl -> my-custom).
# Empty -> "" (board-only build).
keymap_path := env_var_or_default(
  "SMART_KEYMAP_CUSTOM_KEYMAP",
  "",
)
keymap_fn := if keymap_path == "" {
  ""
} else {
  file_name(keymap_path)
}
keymap_parent := if keymap_path == "" {
  ""
} else {
  parent_directory(keymap_path)
}
keymap_parent_name := if keymap_parent == "" {
  ""
} else {
  file_name(keymap_parent)
}
keymap_stem := if keymap_path == "" {
  ""
} else {
  file_stem(keymap_path)
}
keymap_id_raw := if keymap_fn == "keymap.ncl" {
  keymap_parent_name
} else if keymap_fn == "keymap.json" {
  keymap_parent_name
} else {
  keymap_stem
}
keymap_id := if keymap_path == "" {
  ""
} else {
  keymap_id_raw
}

# Build dir and hex include both ids,
#  so `just flash` no longer collides on `build/`.
build_dir := if keymap_id == "" {
  "build-" + board_id
} else {
  "build-" + board_id + "-" + keymap_id
}
hex_name := if keymap_id == "" {
  "usb-device-compositekm-" + board_id + ".hex"
} else {
  "usb-device-compositekm-" + board_id + "-" + keymap_id + ".hex"
}

default: build

_libsmartkeymap:
  make libsmartkeymap

cmake-generate: _libsmartkeymap
  cmake \
    -S . \
    -B {{build_dir}} \
    --toolchain=../../toolchains/riscv-none-elf.cmake \
    -D CMAKE_EXPORT_COMPILE_COMMANDS=1 \
    -D BOARD={{board}}

build: cmake-generate
  cmake --build {{build_dir}}
  test -f {{build_dir}}/usb-device-compositekm.hex && \
    cp {{build_dir}}/usb-device-compositekm.hex \
      {{build_dir}}/{{hex_name}} || true

await-bootloader:
  timeout 30 ./scripts/wchisp-await-bootloader.sh

# Flash: with args flashes that board/keymap directly,
#  without args builds current then picks hex.
#  One hex -> auto, multiple -> fzf or numbered.
#  `just flash ch32x-60-improved`
#  `just flash ch32x-60-improved keymap-66key-extend`
flash board_arg="" keymap_arg="":
  #!/usr/bin/env bash
  set -euo pipefail
  board_arg="{{board_arg}}"
  keymap_arg="{{keymap_arg}}"
  if [ -n "$board_arg" ] || [ -n "$keymap_arg" ]; then
    # Resolve board: bare id -> ncl/boards/<id>.ncl
    #  else full path (ends with .ncl) as is
    eff_board="{{board}}"
    eff_keymap="{{keymap_path}}"
    if [ -n "$board_arg" ]; then
      case "$board_arg" in
        *.ncl) eff_board="$board_arg" ;;
        *) eff_board="ncl/boards/${board_arg}.ncl" ;;
      esac
    fi
    if [ -n "$keymap_arg" ]; then
      case "$keymap_arg" in
        *.ncl|*.json) eff_keymap="$keymap_arg" ;;
        */*) eff_keymap="$keymap_arg" ;;
        *) eff_keymap="tests/ncl/${keymap_arg}/keymap.ncl" ;;
      esac
    fi
    # Derive ids for effective board/keymap
    eff_board_noprefix="${eff_board#ncl/boards/}"
    if [ "$eff_board" != "$eff_board_noprefix" ]; then
      eff_board_noext="${eff_board_noprefix%.ncl}"
      eff_board_id=$(echo "$eff_board_noext" | tr '/' '-')
    else
      eff_board_id=$(basename "$eff_board" .ncl)
    fi
    if [ -z "$eff_keymap" ]; then
      eff_keymap_id=""
    else
      eff_fn=$(basename "$eff_keymap")
      if [ "$eff_fn" = "keymap.ncl" ] \
        || [ "$eff_fn" = "keymap.json" ]; then
        eff_keymap_id=$(basename "$(dirname "$eff_keymap")")
      else
        eff_keymap_id=$(basename "$eff_keymap" \
          | sed 's/\.[^.]*$//')
      fi
    fi
    if [ -z "$eff_keymap_id" ]; then
      eff_build="build-${eff_board_id}"
      eff_hex="usb-device-compositekm-${eff_board_id}.hex"
    else
      eff_build="build-${eff_board_id}-${eff_keymap_id}"
      eff_hex="usb-device-compositekm-${eff_board_id}-${eff_keymap_id}.hex"
    fi
    echo "flash explicit: $eff_board + $eff_keymap"
    echo "-> $eff_build/$eff_hex"
    SMART_KEYMAP_CUSTOM_KEYMAP="$eff_keymap" \
      just --set board "$eff_board" build
    just --set board "$eff_board" await-bootloader
    wchisp flash "$eff_build/$eff_hex"
    exit 0
  fi
  # No explicit args: build current then pick
  hexes=$(find . -maxdepth 2 \
    -name "usb-device-compositekm-*.hex" \
    | sort)
  count=$(echo "$hexes" | grep -c . || true)
  if [ "$count" -eq 0 ]; then
    echo "no hex found" >&2
    exit 1
  fi
  if [ "$count" -eq 1 ]; then
    hex="$hexes"
  else
    if command -v fzf >/dev/null 2>&1; then
      hex=$(echo "$hexes" | fzf --prompt="flash> ")
    else
      echo "multiple hexes:"
      echo "$hexes" | cat -n
      printf "pick number: "
      read -r n || n=1
      if [ -z "$n" ]; then n=1; fi
      hex=$(echo "$hexes" | sed -n "${n}p")
      if [ -z "$hex" ]; then
        hex=$(echo "$hexes" | head -n1)
      fi
    fi
  fi
  test -n "$hex"
  echo "flashing $hex"
  wchisp flash "$hex"

# Show derived ids and paths
info:
  @echo "board={{board}}"
  @echo "board_id={{board_id}}"
  @echo "keymap_path={{keymap_path}}"
  @echo "keymap_id={{keymap_id}}"
  @echo "build_dir={{build_dir}}"
  @echo "hex={{build_dir}}/{{hex_name}}"
